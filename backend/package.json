{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "jest --testPathIgnorePatterns \"tests/load.*\\.test\\.js$\"",
    "test:load": "jest --testTimeout=180000 --runInBand tests/load",
    "test:all": "jest --testTimeout=180000 --runInBand",
    "test:watch": "jest --watch --testPathIgnorePatterns \"tests/load.*\\.test\\.js$\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@supabase/server": "^1.4.1",
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "resend": "^6.19.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "clearMocks": true,
    "restoreMocks": true
  },
  "engines": {
    "node": ">=20"
  }
}
