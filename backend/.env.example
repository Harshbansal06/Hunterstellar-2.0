# Copy to backend/.env and fill in. The server validates these at boot and
# refuses to start if any REQUIRED value is missing, deliberately: it cannot
# serve a useful request without them. See backend/config/env.js.

# --- required -------------------------------------------------------------

# Supabase project settings > API. Use the SERVICE ROLE key here, never the
# anon key: this client bypasses row-level security and must stay server-side.
SUPABASE_URL=
SUPABASE_KEY=

# Signs every crew's session token. Minimum 32 characters, enforced at boot.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# What marshals type into the admin console at /admin.
ADMIN_SECRET=

# Shared with the registration form's Apps Script, which posts to
# /api/team/register with an x-webhook-secret header.
WEBHOOK_SECRET=

# --- optional -------------------------------------------------------------

# Without these, welcome emails are skipped and registration still succeeds.
RESEND_API_KEY=
EMAIL_FROM=

# Defaults to 3005.
PORT=3005

# Number of reverse proxies in front of the app. 1 is correct behind Vercel.
# Setting this too high lets clients spoof X-Forwarded-For and dodge the rate
# limiter; too low collapses every player onto one rate-limit key.
TRUST_PROXY_HOPS=1

# Set to true once db/migrations/003_get_team_state.sql is deployed. The RPC
# then returns clue and puzzle images itself and the extra hydration query per
# /team/state read is skipped. Leave unset if unsure; the default is correct
# either way, just one query slower.
RPC_HAS_IMAGES=
