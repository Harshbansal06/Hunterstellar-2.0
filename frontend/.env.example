# Copy to frontend/.env. Only VITE_-prefixed values reach the browser, so
# never put a secret in this file.

# Where the API lives. Leave as /api in development: vite.config.js proxies
# /api to http://localhost:3005, and a bare path also works in production when
# the API is served from the same origin. Set a full URL for a split deploy.
VITE_API_URL=/api

# Browser Supabase client, used by the leaderboard view and the realtime nudge
# that tells a crew's screen to re-read. Use the ANON key: this one ships to
# the browser and is protected by row-level security, unlike the backend's
# service-role key.
#
# Leave both blank to run without them. The leaderboard then shows its
# "not configured" state instead of failing, and the app falls back to polling.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
