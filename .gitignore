# Dependencies
node_modules/

# Environment files. Everything real is ignored.
.env
.env.*
# Committed on purpose:
#   *.example       the documented template
#   .env.production build-time, non-secret API URL that Vite inlines. It is
#                   visible in the shipped bundle anyway, and leaving it to a
#                   host dashboard is what broke a previous deploy.
!.env.example
!.env.production

# Build outputs
dist/
build/
.next/
out/
.vercel/

# Test + tooling output
coverage/
.nyc_output/
*.log
*.tsbuildinfo

# Editor and OS
.idea/
.vscode/
.opencode/
opencode.json
*.swp
*.swo
.DS_Store
Thumbs.db
